# DineFlow Environment Variables Example
# Copy this file to .env.local and populate with your Supabase project credentials.
# Do NOT commit actual secrets or service keys to version control.

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
